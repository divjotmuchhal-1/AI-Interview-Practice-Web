# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > service_role (server-side only: never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# Dashboard > Products > your subscription price ID
STRIPE_PRICE_ID=price_...
# Dashboard > Developers > Webhooks > signing secret for your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────────
# No trailing slash. Used for Stripe redirect URLs and billing portal return URL.
# Local: http://localhost:3000   Production: https://aicodingprep.com
NEXT_PUBLIC_APP_URL=https://aicodingprep.com

# Error monitoring (optional). Leave unset to disable entirely.
# Create a project at sentry.io, then paste its DSN here and in Vercel.
NEXT_PUBLIC_SENTRY_DSN=
