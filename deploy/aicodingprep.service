# systemd unit for the Next.js server.
# Install location on the server: /etc/systemd/system/aicodingprep.service
#
# systemd is used rather than pm2: it restarts the app on crash and on reboot,
# captures logs in journald, and needs no extra runtime.

[Unit]
Description=AI Interview Practice (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/app

# Secrets live here, owned by deploy and chmod 600. Never in the repo.
EnvironmentFile=/home/deploy/app/.env.production
Environment=NODE_ENV=production

# Bind to loopback explicitly rather than via env vars: Caddy is the only thing
# that should reach the app, and 0.0.0.0 would expose port 3000 to the internet.
ExecStart=/home/deploy/app/node_modules/.bin/next start -H 127.0.0.1 -p 3000

Restart=always
RestartSec=5
# Give the app time to finish in-flight AI streams before a restart kills them.
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aicodingprep

# Hardening: the app needs no privileges beyond reading its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/app/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
