# Caddy reverse proxy for aicodingprep.com
# Install location on the server: /etc/caddy/Caddyfile
#
# Caddy is used instead of nginx because it obtains and renews Let's Encrypt
# certificates automatically, with no cron job or certbot to maintain.

aicodingprep.com, www.aicodingprep.com {
	# Redirect www to the apex so links and cookies stay on one origin.
	@www host www.aicodingprep.com
	redir @www https://aicodingprep.com{uri} permanent

	encode zstd gzip

	# The Next.js server. Security headers and caching come from next.config.ts,
	# so they are not duplicated here.
	reverse_proxy 127.0.0.1:3000 {
		# SSE streaming (/api/chat) must not be buffered: flush each chunk as it
		# arrives, or the AI coach appears to hang and then dump its whole reply.
		flush_interval -1
	}

	log {
		output file /var/log/caddy/aicodingprep.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
